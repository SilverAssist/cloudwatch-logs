{
	"name": "silver-assist/cloudwatch-logs",
	"description": "View, search and follow Amazon CloudWatch Logs from the WordPress admin",
	"type": "wordpress-plugin",
	"license": "PolyForm-Noncommercial-1.0.0",
	"authors": [
		{
			"name": "Silver Assist",
			"homepage": "http://silverassist.com/"
		}
	],
	"keywords": [
		"wordpress",
		"aws",
		"cloudwatch",
		"logs",
		"observability",
		"psr-4"
	],
	"homepage": "http://silverassist.com/",
	"minimum-stability": "stable",
	"require": {
		"php": ">=8.2",
		"aws/aws-sdk-php": "^3.383",
		"composer/installers": "^2.0",
		"silverassist/wp-github-updater": "^1.3",
		"silverassist/wp-plugin-kernel": "^1.0",
		"silverassist/wp-settings-hub": "^1.2"
	},
	"require-dev": {
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0",
		"php-stubs/wordpress-stubs": "^6.6",
		"php-stubs/wordpress-tests-stubs": "^7.0",
		"phpcompatibility/phpcompatibility-wp": "^2.1",
		"phpstan/phpstan": "^2.1",
		"phpunit/phpunit": "^9.6",
		"silverassist/coding-standards": "^1.0",
		"silverassist/wp-coding-standards": "^1.0",
		"squizlabs/php_codesniffer": "^3.7 || ^4.0",
		"szepeviktor/phpstan-wordpress": "^1.3 || ^2.0",
		"wp-coding-standards/wpcs": "^3.0",
		"yoast/phpunit-polyfills": "^2.0"
	},
	"autoload": {
		"psr-4": {
			"SilverAssist\\CloudWatchLogs\\": "includes/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"SilverAssist\\CloudWatchLogs\\Tests\\": "tests/"
		}
	},
	"scripts": {
		"pre-autoload-dump": "Aws\\Script\\Composer\\Composer::removeUnusedServices",
		"phpcs": "phpcs",
		"phpcbf": "phpcbf",
		"phpstan": "phpstan analyse --memory-limit=1G",
		"phpunit": "phpunit",
		"test": "bash scripts/run-quality-checks.sh"
	},
	"extra": {
		"aws/aws-sdk-php": [
			"CloudWatchLogs",
			"SecretsManager"
		]
	},
	"config": {
		"sort-packages": true,
		"allow-plugins": {
			"composer/installers": true,
			"dealerdirect/phpcodesniffer-composer-installer": true
		},
		"platform": {
			"php": "8.2.0"
		}
	},
	"support": {
		"issues": "http://silverassist.com/support",
		"source": "https://github.com/SilverAssist/cloudwatch-logs"
	}
}
