<?xml version="1.0"?>
<ruleset name="Silver Assist CloudWatch Logs">
	<description>Uses the shared SilverAssistWP ruleset from silverassist/wp-coding-standards.</description>

	<!-- What to scan -->
	<file>.</file>

	<!-- Exclude paths -->
	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/.git/*</exclude-pattern>
	<exclude-pattern>*/tests/*</exclude-pattern>
	<exclude-pattern>*/build/*</exclude-pattern>
	<exclude-pattern>*/assets/js/*</exclude-pattern>
	<exclude-pattern>*/assets/css/*</exclude-pattern>

	<!-- Show progress -->
	<arg value="ps"/>

	<!-- Show colors in terminal -->
	<arg name="colors"/>

	<!-- Check code for cross-version PHP compatibility. -->
	<config name="testVersion" value="8.2-"/>

	<rule ref="SilverAssistWP"/>

	<!-- Verify that everything in the global namespace is prefixed.
	     Plugin-specific, can't live in the shared ruleset. -->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="silver_assist_cloudwatch"/>
				<element value="SilverAssist\CloudWatchLogs"/>
			</property>
		</properties>
	</rule>

	<config name="minimum_supported_wp_version" value="6.5"/>
</ruleset>
